# --- Canvas ---
# Canvas -> Account -> Settings -> "Approved Integrations" -> + New Access Token
# Base URL is your school's Canvas address, with no trailing path.
CANVAS_BASE_URL=https://your-school.instructure.com
CANVAS_API_TOKEN=paste_your_token_here

# Optional: only sync these courses (comma-separated Canvas course IDs).
# Run `python canvas_sync.py --list-courses` to see IDs for all your active
# courses, then paste the ones you want here. Leave blank to sync everything.
COURSE_IDS=

# --- Database & on-disk layout ---
DB_PATH=canvas_data.db
INGESTED_DIR=ingested
NOTES_DIR=notes

# --- Used by canvas_sync.py (jot-note summaries), manual_summarize.py and notifier.py ---
ANTHROPIC_API_KEY=paste_your_key_here

# --- notifier.py only (optional; not needed to run the sync) ---
# Telegram -> @BotFather -> /newbot -> copy the token. Then message your bot and
# open https://api.telegram.org/bot<TOKEN>/getUpdates to find "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=paste_bot_token_here
TELEGRAM_CHAT_ID=paste_your_chat_id_here